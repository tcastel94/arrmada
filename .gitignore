# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# Node
node_modules/
.next/
out/
.turbo/

# Environment — NEVER commit these
# `.env.*` couvre aussi les copies (.env.bak-unraid, .env.old…) : une
# sauvegarde de .env contient les mêmes secrets que l'original.
.env
.env.*
!.env.example
*.bak
*.bak-*

# Data & Database
data/
*.db
*.sqlite3

# Scripts output (may contain sensitive data)
backend/scripts/*.txt
backend/scripts/mounts.*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / Coverage
.coverage
htmlcov/
.pytest_cache/

# Docker
*.tar

# Misc
*.log

# Réglages propres à un hôte (PostgreSQL, montages, PUID…) — voir docs/deploy-unraid.md
docker-compose.override.yml

# Copies de .env : mêmes secrets que l'original
.env.*
!.env.example
*.bak
*.bak-*

# Builds versionnés de l'add-on Kodi (régénérés par kodi-addon/build_zip.py)
kodi-addon/script.arrmada-*.zip
