<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton secondaire : contour discret, bleu et épais quand il a le focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/accent_soft" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/accent_soft" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
