<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton principal. L'état « focused » est celui de la télécommande TV :
     il doit se voir de loin (liseré blanc épais). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/accent_disabled" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/accent" />
            <stroke android:width="3dp" android:color="@color/text" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/accent_pressed" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
