<?xml version="1.0" encoding="utf-8"?>
<!--
  ArrMada Android (ADR-007) : appli native pour Android TV (Shield) d'abord.
  Interface Compose for TV, lecteur Media3 ExoPlayer.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android TV : sans ces deux lignes, l'appli n'apparaît pas dans le
         lanceur de la Shield (« leanback ») ou est déclarée incompatible
         (une TV n'a pas d'écran tactile). required="false" : le même APK
         reste installable sur un téléphone ou une tablette. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- networkSecurityConfig : autorise le HTTP du réseau local (voir le fichier).
         banner : la tuile 320×180 du lanceur Android TV. -->
    <application
        android:name=".ArrMadaApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArrMada">

        <!-- configChanges : la fenêtre n'est pas recréée si le mode d'affichage
             change (passage en 24p au lancement d'un film, HDR…) : la lecture
             continue sans coupure. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
