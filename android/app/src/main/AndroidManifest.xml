<?xml version="1.0" encoding="utf-8"?>
<!--
  ArrMada Android : une seule appli pour téléphone, tablette et Android TV.
  L'appli affiche l'interface web du serveur ArrMada (comme un navigateur
  dédié) ; elle ne contient ni données ni logique métier.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android TV : sans ces deux lignes, l'appli n'apparaît pas dans le
         lanceur de la Shield (« leanback ») ou est déclarée incompatible
         (une TV n'a pas d'écran tactile). required="false" : le même APK
         reste installable sur un téléphone. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- networkSecurityConfig : autorise le HTTP du réseau local (voir le fichier).
         banner : la tuile 320×180 du lanceur Android TV. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArrMada">

        <!-- configChanges : tourner le téléphone ne recharge PAS la page
             (sinon on perdrait le formulaire en cours ou la position). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Lanceur des téléphones et tablettes -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Lanceur d'Android TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
