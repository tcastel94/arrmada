# ╔════════════════════════════════════════════════════════════╗
# ║                    ArrMada — .env (OPTIONNEL)              ║
# ╚════════════════════════════════════════════════════════════╝
#
# Ce fichier n'est PAS nécessaire pour installer ArrMada : le mot de passe
# admin se crée dans l'assistant au premier lancement, et les clés API
# *arr y sont saisies puis stockées CHIFFRÉES en base.
#
# Il sert uniquement à surcharger les valeurs du docker-compose.yml :
#   cp .env.example .env   puis décommente ce dont tu as besoin.
# Les valeurs indiquées sont celles par défaut.

# ── Système ───────────────────────────────────────────────────
# TZ=Europe/Paris
# Propriétaire des fichiers du dossier ./data (commande `id` sur l'hôte)
# Synology : souvent 1026/100 — Unraid : 99/100 — Linux : 1000/1000
# PUID=1000
# PGID=1000

# ── PostgreSQL (si docker-compose.postgres.yml) ───────────────
# POSTGRES_PASSWORD=   # ex : openssl rand -hex 24

# ── Services externes (optionnels) ────────────────────────────
# TMDB : affiches, tendances, recommandations
# TMDB_API_KEY=
# Telegram : notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── TV Kodi (appairage) ───────────────────────────────────────
# Adresse de la web app vue depuis le réseau local, pour le QR code
# affiché sur la TV. Vide = adresse du serveur avec le port 3420.
# PUBLIC_WEB_URL=http://192.168.1.10:3420

# ── Caméras Eufy (optionnel) ──────────────────────────────────
# Pop-up « Personne détectée » sur la TV pendant un film. Il faut le
# conteneur eufy-security-ws (docker compose --profile eufy up -d …).
# Compte Eufy SECONDAIRE, invité par le compte principal, sans 2FA.
# EUFY_USERNAME=
# EUFY_PASSWORD=
# EUFY_COUNTRY=FR
# Port d'écoute du pont SUR LE NAS (réseau « host ») : choisir un port libre
# (vérifier : ss -ltn | grep -w 8424). Le même port dans EUFY_WS_URL.
# EUFY_WS_PORT=8424
# Adresse vue par le backend
# EUFY_WS_URL=ws://192.168.1.10:8424
# Détections relayées : person, ring, motion, pet, vehicle, package
# EUFY_DETECTIONS=person

# ── Artworks (logos, disques Blu-ray, clearart, bannières, fonds…) ──
# Trois sources, combinables (la web app les montre toutes dans l'onglet
# Artworks d'une fiche) :
#  1. les dossiers des médias : poster.jpg, fanart.jpg, clearlogo.png,
#     disc.png, clearart.png, banner.jpg, landscape.jpg, extrafanart/…
#     Prioritaires (ce sont tes images). Rien à configurer : ArrMada lit
#     /mnt/user (déjà monté) avec la même traduction de chemins que les NFO.
# ARTWORK_LOCAL_ENABLED=true
#  2. fanart.tv (toutes les variantes : logos HD, disques, clearart…).
#     Clés à créer sur https://fanart.tv/get-an-api-key/ (compte gratuit) :
#       FANART_CLIENT_KEY = clé PERSONNELLE — suffit seule, et les nouvelles
#                           images arrivent après 2 jours au lieu de 7 ;
#       FANART_API_KEY    = clé de PROJET (facultative).
# FANART_CLIENT_KEY=
# FANART_API_KEY=
#  3. TMDB (TMDB_API_KEY plus haut) : logos, affiches, fonds.
# Récupère tout seul les artworks des nouveaux titres, toutes les N heures
# (le bouton « Artworks » de la Médiathèque reste disponible).
# ARTWORK_AUTO_ENABLED=true
# ARTWORK_AUTO_INTERVAL_HOURS=24

# ── Auto-import ───────────────────────────────────────────────
# Job qui importe automatiquement les téléchargements terminés mais
# non importés. Mettre false pour le désactiver complètement.
# AUTO_IMPORT_ENABLED=true
# AUTO_IMPORT_INTERVAL_MINUTES=5
# Laisser à false : le job refuse alors de remplacer un épisode/film
# qui a déjà un fichier. Les parsers *arr se trompent (numérotation par
# cour des animes, par ex.) et un écrasement automatique est définitif.
# AUTO_IMPORT_ALLOW_OVERWRITE=false
# Packs de saison bloqués dans Sonarr (« Single episode file contains all
# episodes in seasons », fichiers « 01. Titre.mkv » sans S01E01) : importés
# tout seuls quand le numéro ET le titre de chaque fichier correspondent à
# l'épisode. Au moindre doute, rien n'est importé (rapport dans Imports).
# AUTO_IMPORT_BLOCKED_PACKS=true
# Dossier des téléchargements terminés, vu depuis Sonarr/Radarr.
# Doit être sur le MÊME montage que la médiathèque : un bind mount
# Docker distinct de la même share fait échouer link() (EXDEV) et
# transforme chaque import en copie de plusieurs Go.
# ARR_DOWNLOADS_PATH=/media/downloads/complete

# ── IA (optionnel) ───────────────────────────────────────────
# Analyse des logs Docker, recherche en langage naturel, bilan hebdo.
# Local (prioritaire si défini) : serveur Ollama du réseau.
# OLLAMA_URL=http://192.168.x.x:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# Cloud (repli) : clé OpenRouter + modèle.
# OPENROUTER_API_KEY=
# AI_MODEL=google/gemini-2.0-flash-001

# ── Unraid (optionnel, pour discovery Docker mounts) ──────────
# UNRAID_URL=
# UNRAID_API_KEY=

# ── Avancé ────────────────────────────────────────────────────
# Derrière un reverse proxy (Synology, Traefik, NPM…), son IP pour que
# l'anti brute-force voie l'IP réelle des clients :
# FORWARDED_ALLOW_IPS=127.0.0.1,192.168.1.2
#
# Ancien mot de passe en clair : encore accepté pour les installations
# existantes, à remplacer depuis Paramètres → Mot de passe administrateur.
# ARRMADA_AUTH_SECRET=
