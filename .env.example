# ╔════════════════════════════════════════════════════════════╗
# ║                    ArrMada — .env                         ║
# ╚════════════════════════════════════════════════════════════╝

# ── Auth (OBLIGATOIRE) ────────────────────────────────────────
# Mot de passe pour accéder à ArrMada
ARRMADA_AUTH_SECRET=changeme_use_a_strong_password

# ── Database ──────────────────────────────────────────────────
# Par défaut : PostgreSQL intégrée (aucune config nécessaire)
# Pour utiliser une base PostgreSQL EXTERNE existante, décommenter :
# DATABASE_URL=postgresql+asyncpg://user:password@your-host:5432/arrmada
#
# Pour revenir à SQLite (dev uniquement) :
# DATABASE_URL=sqlite+aiosqlite:///./data/arrmada.db

# Mot de passe de la base PG intégrée (par défaut: arrmada)
POSTGRES_PASSWORD=arrmada

# ── Ports ─────────────────────────────────────────────────────
# Ports exposés (par défaut: 8420 backend, 3420 frontend)
# BACKEND_PORT=8420
# FRONTEND_PORT=3420

# ── CORS ──────────────────────────────────────────────────────
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3420

# ── Telegram (optionnel) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── TMDB (optionnel, pour recommandations & posters) ──────────
TMDB_API_KEY=

# ── Auto-import ───────────────────────────────────────────────
# Job qui importe automatiquement les téléchargements terminés mais
# non importés. Mettre false pour le désactiver complètement.
AUTO_IMPORT_ENABLED=true
AUTO_IMPORT_INTERVAL_MINUTES=5
# Laisser à false : le job refuse alors de remplacer un épisode/film
# qui a déjà un fichier. Les parsers *arr se trompent (numérotation par
# cour des animes, par ex.) et un écrasement automatique est définitif.
AUTO_IMPORT_ALLOW_OVERWRITE=false
# Dossier des telechargements termines, vu depuis Sonarr/Radarr.
# Doit etre sur le MEME montage que la mediatheque : un bind mount
# Docker distinct de la meme share fait echouer link() (EXDEV) et
# transforme chaque import en copie de plusieurs Go.
ARR_DOWNLOADS_PATH=/media/downloads/complete

# ── Unraid (optionnel, pour discovery Docker mounts) ──────────
# UNRAID_URL=
# UNRAID_API_KEY=

# ╔════════════════════════════════════════════════════════════╗
# ║  Les clés API des services *arr (Sonarr, Radarr, etc.)   ║
# ║  sont configurées via le Setup Wizard au premier          ║
# ║  lancement et stockées CHIFFRÉES en base de données.     ║
# ║  ➜ Rien à mettre ici pour les services *arr !            ║
# ╚════════════════════════════════════════════════════════════╝
