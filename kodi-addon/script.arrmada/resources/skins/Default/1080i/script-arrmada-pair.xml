<?xml version="1.0" encoding="UTF-8"?>
<!--
  ArrMada — écran « Appairer cette TV » (phase 1, ADR-003 § 4).

  Rempli par lib/pair_window.py, via la propriété « state » :
    loading  demande d'un code au serveur
    waiting  code en 6 cases + QR code + compte à rebours (on attend la web app)
    done     TV appairée : nom, pièce, ampli
    expired  code périmé → bouton « Nouveau code » (901)
    error    serveur injoignable / refus → bouton « Réessayer » (901)
  Retour : annuler.
-->
<window>
	<defaultcontrol always="false">901</defaultcontrol>
	<backgroundcolor>FF0A0E16</backgroundcolor>
	<animation effect="fade" start="0" end="100" time="300" tween="sine" easing="out">WindowOpen</animation>
