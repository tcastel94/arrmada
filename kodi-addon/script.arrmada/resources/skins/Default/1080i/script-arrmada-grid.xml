<?xml version="1.0" encoding="UTF-8"?>
<!--
  ArrMada — grille Films / Séries / Découvrir (ADR-004, phase 4.2).

  Repère 1920 × 1080. Données posées par lib/grid_window.py :
    - onglets (200) : vues de la bibliothèque ou de Découvrir ;
    - mur d'affiches (300), 7 par ligne, rempli page par page ;
    - en haut, le titre sélectionné (Container(300).ListItem…).
  Navigation : onglets (200) ↓ affiches (300) ; OK sur un onglet le choisit.
-->
<window>
	<defaultcontrol always="false">200</defaultcontrol>
	<backgroundcolor>FF0A0E16</backgroundcolor>
	<animation effect="fade" start="0" end="100" time="300" tween="sine" easing="out">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>

		<!-- ═══════════════ FOND : fanart du titre sélectionné, très discret ═══════════════ -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0A0E16">arrmada/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>600</fadetime>
			<texture background="true" colordiffuse="38FFFFFF">$INFO[Container(300).ListItem.Art(fanart)]</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="E60A0E16">arrmada/grad-v.png</texture>
		</control>
		<control type="image">
			<left>-300</left><top>-380</top><width>1200</width><height>900</height>
			<texture colordiffuse="334A9EFF">arrmada/blob.png</texture>
			<animation effect="fade" start="100" end="50" time="5000" tween="sine" pulse="true" condition="true">Conditional</animation>
		</control>

		<!-- ═══════════════ EN-TÊTE : titre de l'écran, vue, compteur ═══════════════ -->
		<control type="group">
			<animation effect="slide" start="-60,0" end="0,0" time="500" tween="cubic" easing="out">WindowOpen</animation>
			<control type="label">
				<left>96</left><top>34</top><width>700</width><height>72</height>
				<font>font52_bold</font>
				<textcolor>FFF5F7FA</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Window.Property(title)]</label>
			</control>
			<control type="label">
				<left>1124</left><top>48</top><width>700</width><height>44</height>
				<font>font12</font>
				<textcolor>99C9D3E0</textcolor>
				<align>right</align><aligny>center</aligny>
				<label>$INFO[Window.Property(subtitle),, · ]$INFO[Window.Property(status)]</label>
			</control>
		</control>

		<!-- ═══════════════ ONGLETS ═══════════════ -->
		<control type="list" id="200">
			<left>80</left><top>120</top><width>1760</width><height>64</height>
			<orientation>horizontal</orientation>
			<ondown>300</ondown>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<itemlayout width="318" height="64">
				<control type="image">
					<left>16</left><top>6</top><width>298</width><height>52</height>
					<texture border="14" colordiffuse="14FFFFFF">arrmada/rounded-12.png</texture>
				</control>
				<control type="label">
					<left>16</left><top>6</top><width>298</width><height>52</height>
					<font>font12</font>
					<textcolor>B3F5F7FA</textcolor>
					<align>center</align><aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout width="318" height="64">
				<control type="image">
					<left>16</left><top>6</top><width>298</width><height>52</height>
					<texture border="14" colordiffuse="FF4A9EFF">arrmada/rounded-12.png</texture>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="image">
					<left>16</left><top>6</top><width>298</width><height>52</height>
					<texture border="14" colordiffuse="404A9EFF">arrmada/rounded-12.png</texture>
					<visible>!Control.HasFocus(200)</visible>
				</control>
				<control type="label">
					<left>16</left><top>6</top><width>298</width><height>52</height>
					<font>font12</font>
					<textcolor>FF0A0E16</textcolor>
					<align>center</align><aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="label">
					<left>16</left><top>6</top><width>298</width><height>52</height>
					<font>font12</font>
					<textcolor>FFF5F7FA</textcolor>
					<align>center</align><aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<visible>!Control.HasFocus(200)</visible>
				</control>
			</focusedlayout>
		</control>

		<!-- ═══════════════ TITRE SÉLECTIONNÉ ═══════════════ -->
		<control type="group">
			<visible>Integer.IsGreater(Container(300).NumItems,0)</visible>
			<control type="label">
				<left>96</left><top>196</top><width>1000</width><height>44</height>
				<font>font14_title</font>
				<textcolor>FFF5F7FA</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Container(300).ListItem.Label]</label>
			</control>
			<control type="label">
				<left>1100</left><top>196</top><width>724</width><height>44</height>
				<font>font12</font>
				<textcolor>FF9CCBFF</textcolor>
				<align>right</align><aligny>center</aligny>
				<label>$INFO[Container(300).ListItem.Property(kodi_status),, · ]$INFO[Container(300).ListItem.Label2]</label>
			</control>
		</control>

		<!-- ═══════════════ CHARGEMENT / ERREUR ═══════════════ -->
		<control type="label">
			<left>96</left><top>300</top><width>1600</width><height>60</height>
			<font>font13</font>
			<textcolor>80C9D3E0</textcolor>
			<aligny>center</aligny>
			<label>Chargement…</label>
			<visible>String.IsEqual(Window.Property(status),Chargement…) + String.IsEmpty(Window.Property(error))</visible>
			<animation effect="fade" start="100" end="35" time="900" tween="sine" pulse="true" condition="true">Conditional</animation>
		</control>
		<control type="label">
			<left>96</left><top>300</top><width>1600</width><height>60</height>
			<font>font13</font>
			<textcolor>FFFBBF24</textcolor>
			<aligny>center</aligny>
			<label>$INFO[Window.Property(error)]</label>
			<visible>!String.IsEmpty(Window.Property(error))</visible>
		</control>
		<control type="label">
			<left>96</left><top>300</top><width>1600</width><height>60</height>
			<font>font13</font>
			<textcolor>80C9D3E0</textcolor>
			<aligny>center</aligny>
			<label>Aucun titre dans cette vue.</label>
			<visible>String.IsEqual(Window.Property(status),0 titre) + String.IsEmpty(Window.Property(error))</visible>
		</control>

		<!-- ═══════════════ MUR D'AFFICHES ═══════════════ -->
		<control type="panel" id="300">
			<left>80</left><top>250</top><width>1760</width><height>830</height>
			<orientation>vertical</orientation>
			<onup>200</onup>
			<scrolltime tween="cubic" easing="out">300</scrolltime>
			<itemlayout width="251" height="410">
				<control type="group">
					<left>16</left><top>20</top>
					<animation effect="fade" start="100" end="45" time="0" condition="String.IsEqual(ListItem.Property(unavailable),1)">Conditional</animation>
					<control type="image">
						<left>0</left><top>0</top><width>219</width><height>328</height>
						<texture border="26" colordiffuse="17FFFFFF">arrmada/rounded-24.png</texture>
					</control>
					<control type="label">
						<left>14</left><top>0</top><width>191</width><height>328</height>
						<font>font12</font>
						<textcolor>B3F5F7FA</textcolor>
						<align>center</align><aligny>center</aligny>
						<wrapmultiline>true</wrapmultiline>
						<label>$INFO[ListItem.Label]</label>
						<visible>String.IsEmpty(ListItem.Art(poster))</visible>
					</control>
					<control type="image">
						<left>0</left><top>0</top><width>219</width><height>328</height>
						<aspectratio>scale</aspectratio>
						<fadetime>200</fadetime>
						<texture background="true" diffuse="arrmada/poster-mask.png">$INFO[ListItem.Art(poster)]</texture>
					</control>
					<control type="group">
						<left>145</left><top>12</top>
						<visible>String.IsEqual(ListItem.Property(watched),1)</visible>
						<control type="image">
							<left>0</left><top>0</top><width>62</width><height>30</height>
							<texture border="14" colordiffuse="E634D399">arrmada/rounded-12.png</texture>
						</control>
						<control type="label">
							<left>0</left><top>0</top><width>62</width><height>30</height>
							<font>font10</font>
							<textcolor>FF0A0E16</textcolor>
							<align>center</align><aligny>center</aligny>
							<label>Vu</label>
						</control>
					</control>
					<control type="image">
						<left>14</left><top>306</top><width>191</width><height>8</height>
						<texture>arrmada/progress/$INFO[ListItem.Property(bar)].png</texture>
						<visible>!String.IsEmpty(ListItem.Property(bar))</visible>
					</control>
					<control type="label">
						<left>0</left><top>338</top><width>219</width><height>30</height>
						<font>font10</font>
						<textcolor>B3F5F7FA</textcolor>
						<align>center</align><aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</control>
			</itemlayout>
			<focusedlayout width="251" height="410">
				<control type="group">
					<left>16</left><top>20</top>
					<animation type="Focus">
						<effect type="zoom" start="100" end="108" time="220" tween="cubic" easing="out" center="110,164"/>
					</animation>
					<animation type="UnFocus">
						<effect type="zoom" start="108" end="100" time="180" tween="cubic" easing="out" center="110,164"/>
					</animation>
					<control type="image">
						<left>-36</left><top>-36</top><width>291</width><height>400</height>
						<texture border="56" colordiffuse="A64A9EFF">arrmada/glow.png</texture>
						<visible>Control.HasFocus(300)</visible>
					</control>
					<control type="image">
						<left>0</left><top>0</top><width>219</width><height>328</height>
						<texture border="26" colordiffuse="FF1A2233">arrmada/rounded-24.png</texture>
					</control>
					<control type="label">
						<left>14</left><top>0</top><width>191</width><height>328</height>
						<font>font12</font>
						<textcolor>FFF5F7FA</textcolor>
						<align>center</align><aligny>center</aligny>
						<wrapmultiline>true</wrapmultiline>
						<label>$INFO[ListItem.Label]</label>
						<visible>String.IsEmpty(ListItem.Art(poster))</visible>
					</control>
					<control type="image">
						<left>0</left><top>0</top><width>219</width><height>328</height>
						<aspectratio>scale</aspectratio>
						<fadetime>200</fadetime>
						<texture background="true" diffuse="arrmada/poster-mask.png">$INFO[ListItem.Art(poster)]</texture>
					</control>
					<control type="image">
						<left>0</left><top>0</top><width>219</width><height>328</height>
						<texture colordiffuse="FF4A9EFF">arrmada/poster-ring.png</texture>
						<visible>Control.HasFocus(300)</visible>
					</control>
					<control type="group">
						<left>145</left><top>12</top>
						<visible>String.IsEqual(ListItem.Property(watched),1)</visible>
						<control type="image">
							<left>0</left><top>0</top><width>62</width><height>30</height>
							<texture border="14" colordiffuse="FF34D399">arrmada/rounded-12.png</texture>
						</control>
						<control type="label">
							<left>0</left><top>0</top><width>62</width><height>30</height>
							<font>font10</font>
							<textcolor>FF0A0E16</textcolor>
							<align>center</align><aligny>center</aligny>
							<label>Vu</label>
						</control>
					</control>
					<control type="image">
						<left>14</left><top>306</top><width>191</width><height>8</height>
						<texture>arrmada/progress/$INFO[ListItem.Property(bar)].png</texture>
						<visible>!String.IsEmpty(ListItem.Property(bar))</visible>
					</control>
				</control>
				<control type="label">
					<left>16</left><top>360</top><width>219</width><height>30</height>
					<font>font10</font>
					<textcolor>FFF5F7FA</textcolor>
					<align>center</align><aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>
	</controls>
</window>
