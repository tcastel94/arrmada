<?xml version="1.0" encoding="UTF-8"?>
<!--
  ArrMada — dialogue « Débloquer » (ADR-005, lot 3).

  Rempli par lib/unstick_window.py, via la propriété « state » :
    loading  diagnostic demandé au serveur
    ready    diagnostic affiché (3 lignes au plus : vert = ok, rouge = problème,
             bleu = ce que le bouton va faire) ; bouton d'action (961) si un
             remède existe, sinon « Fermer » seul
    working  remède en cours
  Le serveur refait le diagnostic au moment d'agir (la TV ne choisit rien).
  Rien n'est effacé ni écrasé dans la médiathèque.
-->
<window type="dialog">
	<defaultcontrol always="false">962</defaultcontrol>
	<animation effect="fade" start="0" end="100" time="250" tween="sine" easing="out">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="CC05070C">arrmada/white.png</texture>
		</control>

		<control type="group">
			<left>360</left><top>230</top>
			<animation effect="zoom" start="94" end="100" time="350" tween="cubic" easing="out" center="600,310">WindowOpen</animation>
			<control type="image">
				<width>1200</width><height>620</height>
				<texture border="26" colordiffuse="FF121826">arrmada/rounded-24.png</texture>
			</control>
			<control type="image">
				<width>1200</width><height>620</height>
				<texture border="26" colordiffuse="334A9EFF">arrmada/ring-24.png</texture>
			</control>
			<control type="label">
				<left>64</left><top>44</top><width>1072</width><height>40</height>
				<font>font12</font>
				<textcolor>FF22D3EE</textcolor>
				<aligny>center</aligny>
				<label>Débloquer</label>
			</control>
			<control type="label">
				<left>64</left><top>88</top><width>1072</width><height>60</height>
				<font>font15_bold</font>
				<textcolor>FFF5F7FA</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Window.Property(title)]</label>
			</control>

			<!-- Chargement -->
			<control type="label">
				<left>64</left><top>220</top><width>1072</width><height>80</height>
				<font>font13</font>
				<textcolor>B3DCE3EE</textcolor>
				<aligny>center</aligny>
				<label>Diagnostic en cours…</label>
				<visible>String.IsEqual(Window.Property(state),loading)</visible>
				<animation effect="fade" start="100" end="45" time="900" tween="sine" pulse="true" condition="true">Conditional</animation>
			</control>

			<!-- Diagnostic : 3 lignes (état, texte, détail) -->
			<control type="group">
				<left>64</left><top>180</top>
				<visible>!String.IsEqual(Window.Property(state),loading)</visible>
				<control type="image">
					<left>0</left><top>14</top><width>28</width><height>28</height>
					<texture colordiffuse="FF34D399">arrmada/circle.png</texture>
					<visible>String.IsEqual(Window.Property(s1_state),ok)</visible>
				</control>
				<control type="image">
					<left>0</left><top>14</top><width>28</width><height>28</height>
					<texture colordiffuse="FFF87171">arrmada/circle.png</texture>
					<visible>String.IsEqual(Window.Property(s1_state),err)</visible>
				</control>
				<control type="image">
					<left>0</left><top>14</top><width>28</width><height>28</height>
					<texture colordiffuse="FF4A9EFF">arrmada/circle.png</texture>
					<visible>String.IsEqual(Window.Property(s1_state),next)</visible>
				</control>
				<control type="label">
					<left>52</left><top>4</top><width>1020</width><height>48</height>
					<font>font13</font>
					<textcolor>FFF5F7FA</textcolor>
					<aligny>center</aligny>
					<label>$INFO[Window.Property(s1_text)]</label>
				</control>
				<control type="label">
					<left>52</left><top>50</top><width>1020</width><height>32</height>
					<font>font10</font>
					<textcolor>99C9D3E0</textcolor>
					<aligny>center</aligny>
					<label>$INFO[Window.Property(s1_detail)]</label>
				</control>

				<control type="image">
					<left>0</left><top>114</top><width>28</width><height>28</height>
					<texture colordiffuse="FF34D399">arrmada/circle.png</texture>
					<visible>String.IsEqual(Window.Property(s2_state),ok)</visible>
				</control>
				<control type="image">
					<left>0</left><top>114</top><width>28</width><height>28</height>
					<texture colordiffuse="FFF87171">arrmada/circle.png</texture>
					<visible>String.IsEqual(Window.Property(s2_state),err)</visible>
				</control>
				<control type="image">
					<left>0</left><top>114</top><width>28</width><height>28</height>
					<texture colordiffuse="FF4A9EFF">arrmada/circle.png</texture>
					<visible>String.IsEqual(Window.Property(s2_state),next)</visible>
				</control>
				<control type="label">
					<left>52</left><top>104</top><width>1020</width><height>48</height>
					<font>font13</font>
					<textcolor>FFF5F7FA</textcolor>
					<aligny>center</aligny>
					<label>$INFO[Window.Property(s2_text)]</label>
				</control>
				<control type="label">
					<left>52</left><top>150</top><width>1020</width><height>32</height>
					<font>font10</font>
					<textcolor>99C9D3E0</textcolor>
					<aligny>center</aligny>
					<label>$INFO[Window.Property(s2_detail)]</label>
				</control>

				<control type="image">
					<left>0</left><top>214</top><width>28</width><height>28</height>
					<texture colordiffuse="FF34D399">arrmada/circle.png</texture>
					<visible>String.IsEqual(Window.Property(s3_state),ok)</visible>
				</control>
				<control type="image">
					<left>0</left><top>214</top><width>28</width><height>28</height>
					<texture colordiffuse="FFF87171">arrmada/circle.png</texture>
					<visible>String.IsEqual(Window.Property(s3_state),err)</visible>
				</control>
				<control type="image">
					<left>0</left><top>214</top><width>28</width><height>28</height>
					<texture colordiffuse="FF4A9EFF">arrmada/circle.png</texture>
					<visible>String.IsEqual(Window.Property(s3_state),next)</visible>
				</control>
				<control type="label">
					<left>52</left><top>204</top><width>1020</width><height>48</height>
					<font>font13</font>
					<textcolor>FFF5F7FA</textcolor>
					<aligny>center</aligny>
					<label>$INFO[Window.Property(s3_text)]</label>
				</control>
				<control type="label">
					<left>52</left><top>250</top><width>1020</width><height>32</height>
					<font>font10</font>
					<textcolor>99C9D3E0</textcolor>
					<aligny>center</aligny>
					<label>$INFO[Window.Property(s3_detail)]</label>
				</control>
			</control>

			<!-- Boutons -->
			<control type="grouplist" id="960">
				<left>64</left><top>500</top><width>1072</width><height>72</height>
				<orientation>horizontal</orientation>
				<itemgap>16</itemgap>
				<align>right</align>
				<control type="button" id="962">
					<width>240</width><height>72</height>
					<label>$INFO[Window.Property(close_label)]</label>
					<font>font13</font>
					<textcolor>D9F5F7FA</textcolor>
					<focusedcolor>FF0A0E16</focusedcolor>
					<align>center</align><aligny>center</aligny>
					<texturenofocus border="14" colordiffuse="1AFFFFFF">arrmada/rounded-12.png</texturenofocus>
					<texturefocus border="14" colordiffuse="FF4A9EFF">arrmada/rounded-12.png</texturefocus>
					<animation effect="zoom" start="100" end="105" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
					<animation effect="zoom" start="105" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
				</control>
				<control type="button" id="961">
					<width>460</width><height>72</height>
					<label>$INFO[Window.Property(action)]</label>
					<font>font13</font>
					<textcolor>FF8CC4FF</textcolor>
					<focusedcolor>FF0A0E16</focusedcolor>
					<align>center</align><aligny>center</aligny>
					<texturenofocus border="14" colordiffuse="334A9EFF">arrmada/rounded-12.png</texturenofocus>
					<texturefocus border="14" colordiffuse="FF4A9EFF">arrmada/rounded-12.png</texturefocus>
					<visible>String.IsEqual(Window.Property(state),ready) + !String.IsEmpty(Window.Property(action))</visible>
					<animation effect="zoom" start="100" end="105" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
					<animation effect="zoom" start="105" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
				</control>
			</control>
			<control type="image">
				<left>80</left><top>518</top><width>36</width><height>36</height>
				<texture colordiffuse="FF4A9EFF">arrmada/spinner.png</texture>
				<visible>String.IsEqual(Window.Property(state),working) | String.IsEqual(Window.Property(state),loading)</visible>
				<animation effect="rotate" end="-360" center="auto" time="900" loop="true" condition="true">Conditional</animation>
			</control>
		</control>
	</controls>
</window>
