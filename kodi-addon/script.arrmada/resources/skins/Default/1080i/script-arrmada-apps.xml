<?xml version="1.0" encoding="UTF-8"?>
<!--
  ArrMada — Applis & sources (ADR-004, phase 4.3) : add-ons vidéo et audio,
  TV en direct, dossiers du NAS, favoris de Kodi, applis Android.

  Repère 1920 × 1080. Données posées par lib/apps_window.py :
    - onglets (200), masqués à l'intérieur d'un dossier (propriété browsing) ;
    - tuiles (300) : racine des onglets Vidéo, Musique, Dossiers, Favoris,
      Applis Android (propriété layout = tiles) ;
    - liste (400) + aperçu à droite : chaînes de la TV en direct et contenu
      d'un dossier ou d'un add-on (layout = list).
  Navigation : onglets (200) ↓ tuiles (300) ou liste (400) ; Retour remonte
  d'un dossier, puis ferme l'écran.
-->
<window>
	<defaultcontrol always="false">200</defaultcontrol>
	<backgroundcolor>FF0A0E16</backgroundcolor>
	<animation effect="fade" start="0" end="100" time="300" tween="sine" easing="out">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>

		<!-- ═══════════════ FOND : fanart de l'élément sélectionné, discret ═══════════════ -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0A0E16">arrmada/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>600</fadetime>
			<texture background="true" colordiffuse="38FFFFFF">$INFO[Container(300).ListItem.Art(fanart)]</texture>
			<visible>String.IsEqual(Window.Property(layout),tiles)</visible>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>600</fadetime>
			<texture background="true" colordiffuse="38FFFFFF">$INFO[Container(400).ListItem.Art(fanart)]</texture>
			<visible>String.IsEqual(Window.Property(layout),list)</visible>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="E60A0E16">arrmada/grad-v.png</texture>
		</control>
		<control type="image">
			<left>-300</left><top>-380</top><width>1200</width><height>900</height>
			<texture colordiffuse="334A9EFF">arrmada/blob.png</texture>
			<animation effect="fade" start="100" end="50" time="5000" tween="sine" pulse="true" condition="true">Conditional</animation>
		</control>

		<!-- ═══════════════ EN-TÊTE : titre, chemin, compteur, heure ═══════════════ -->
		<control type="group">
			<animation effect="slide" start="-60,0" end="0,0" time="500" tween="cubic" easing="out">WindowOpen</animation>
			<control type="label">
				<left>96</left><top>34</top><width>1200</width><height>72</height>
				<font>font52_bold</font>
				<textcolor>FFF5F7FA</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Window.Property(title)]</label>
			</control>
			<control type="label">
				<left>1240</left><top>34</top><width>600</width><height>72</height>
				<font>font30</font>
				<textcolor>E6F5F7FA</textcolor>
				<align>right</align><aligny>center</aligny>
				<label>$INFO[System.Time]</label>
			</control>
		</control>

		<!-- ═══════════════ ONGLETS (racine) ═══════════════ -->
		<control type="list" id="200">
			<left>80</left><top>120</top><width>1760</width><height>64</height>
			<orientation>horizontal</orientation>
			<ondown condition="String.IsEqual(Window.Property(layout),tiles)">300</ondown>
			<ondown condition="String.IsEqual(Window.Property(layout),list)">400</ondown>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<visible>String.IsEmpty(Window.Property(browsing))</visible>
			<itemlayout width="290" height="64">
				<control type="image">
					<left>16</left><top>6</top><width>270</width><height>52</height>
					<texture border="14" colordiffuse="14FFFFFF">arrmada/rounded-12.png</texture>
				</control>
				<control type="label">
					<left>16</left><top>6</top><width>270</width><height>52</height>
					<font>font12</font>
					<textcolor>B3F5F7FA</textcolor>
					<align>center</align><aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout width="290" height="64">
				<control type="image">
					<left>16</left><top>6</top><width>270</width><height>52</height>
					<texture border="14" colordiffuse="FF4A9EFF">arrmada/rounded-12.png</texture>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="image">
					<left>16</left><top>6</top><width>270</width><height>52</height>
					<texture border="14" colordiffuse="404A9EFF">arrmada/rounded-12.png</texture>
					<visible>!Control.HasFocus(200)</visible>
				</control>
				<control type="label">
					<left>16</left><top>6</top><width>270</width><height>52</height>
					<font>font12</font>
					<textcolor>FF0A0E16</textcolor>
					<align>center</align><aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="label">
					<left>16</left><top>6</top><width>270</width><height>52</height>
					<font>font12</font>
					<textcolor>FFF5F7FA</textcolor>
					<align>center</align><aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<visible>!Control.HasFocus(200)</visible>
				</control>
			</focusedlayout>
		</control>

		<!-- ═══════════════ CHEMIN (dans un dossier) + compteur ═══════════════ -->
		<control type="label">
			<left>96</left><top>126</top><width>1300</width><height>52</height>
			<font>font13</font>
			<textcolor>FF9CCBFF</textcolor>
			<aligny>center</aligny>
			<label>$INFO[Window.Property(crumb)]</label>
			<visible>!String.IsEmpty(Window.Property(browsing))</visible>
		</control>
		<control type="label">
			<left>1340</left><top>126</top><width>484</width><height>52</height>
			<font>font12</font>
			<textcolor>99C9D3E0</textcolor>
			<align>right</align><aligny>center</aligny>
			<label>$INFO[Window.Property(status)]</label>
			<visible>!String.IsEmpty(Window.Property(browsing))</visible>
		</control>

		<!-- ═══════════════ CHARGEMENT / VIDE / ERREUR ═══════════════ -->
		<control type="label">
			<left>96</left><top>230</top><width>1600</width><height>60</height>
			<font>font13</font>
			<textcolor>80C9D3E0</textcolor>
			<aligny>center</aligny>
			<label>Chargement…</label>
			<visible>!String.IsEmpty(Window.Property(loading))</visible>
			<animation effect="fade" start="100" end="35" time="900" tween="sine" pulse="true" condition="true">Conditional</animation>
		</control>
		<control type="textbox">
			<left>96</left><top>230</top><width>1500</width><height>140</height>
			<font>font13</font>
			<textcolor>FFFBBF24</textcolor>
			<label>$INFO[Window.Property(message)]</label>
			<visible>String.IsEmpty(Window.Property(loading)) + !String.IsEmpty(Window.Property(message))</visible>
		</control>

		<!-- ═══════════════ TUILES (add-ons, dossiers, favoris, applis) ═══════════════ -->
		<control type="panel" id="300">
			<left>80</left><top>200</top><width>1760</width><height>880</height>
			<orientation>vertical</orientation>
			<onup>200</onup>
			<scrolltime tween="cubic" easing="out">300</scrolltime>
			<visible>String.IsEqual(Window.Property(layout),tiles)</visible>
			<itemlayout width="251" height="300">
				<control type="group">
					<left>16</left><top>20</top>
					<control type="image">
						<left>0</left><top>0</top><width>219</width><height>219</height>
						<texture border="26" colordiffuse="17FFFFFF">arrmada/rounded-24.png</texture>
					</control>
					<control type="image">
						<left>34</left><top>34</top><width>151</width><height>151</height>
						<aspectratio>keep</aspectratio>
						<fadetime>200</fadetime>
						<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="label">
						<left>0</left><top>228</top><width>219</width><height>30</height>
						<font>font10</font>
						<textcolor>B3F5F7FA</textcolor>
						<align>center</align><aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</control>
			</itemlayout>
			<focusedlayout width="251" height="300">
				<control type="group">
					<left>16</left><top>20</top>
					<animation type="Focus">
						<effect type="zoom" start="100" end="108" time="220" tween="cubic" easing="out" center="110,110"/>
					</animation>
					<animation type="UnFocus">
						<effect type="zoom" start="108" end="100" time="180" tween="cubic" easing="out" center="110,110"/>
					</animation>
					<control type="image">
						<left>-36</left><top>-36</top><width>291</width><height>291</height>
						<texture border="56" colordiffuse="A64A9EFF">arrmada/glow.png</texture>
						<visible>Control.HasFocus(300)</visible>
					</control>
					<control type="image">
						<left>0</left><top>0</top><width>219</width><height>219</height>
						<texture border="26" colordiffuse="FF1A2233">arrmada/rounded-24.png</texture>
					</control>
					<control type="image">
						<left>34</left><top>34</top><width>151</width><height>151</height>
						<aspectratio>keep</aspectratio>
						<fadetime>200</fadetime>
						<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="image">
						<left>0</left><top>0</top><width>219</width><height>219</height>
						<texture border="26" colordiffuse="FF4A9EFF">arrmada/poster-ring.png</texture>
						<visible>Control.HasFocus(300)</visible>
					</control>
				</control>
				<control type="label">
					<left>16</left><top>256</top><width>219</width><height>30</height>
					<font>font10</font>
					<textcolor>FFF5F7FA</textcolor>
					<align>center</align><aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>
		<!-- Élément sélectionné dans les tuiles : nom et description, en bas -->
		<control type="group">
			<visible>String.IsEqual(Window.Property(layout),tiles) + Integer.IsGreater(Container(300).NumItems,0)</visible>
			<control type="image">
				<left>0</left><top>960</top><width>1920</width><height>120</height>
				<texture colordiffuse="F20A0E16">arrmada/white.png</texture>
			</control>
			<control type="label">
				<left>96</left><top>972</top><width>1100</width><height>44</height>
				<font>font14_title</font>
				<textcolor>FFF5F7FA</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Container(300).ListItem.Label]</label>
			</control>
			<control type="label">
				<left>96</left><top>1016</top><width>1500</width><height>40</height>
				<font>font12</font>
				<textcolor>FF9CCBFF</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Container(300).ListItem.Label2]</label>
			</control>
			<control type="label">
				<left>1240</left><top>972</top><width>584</width><height>44</height>
				<font>font12</font>
				<textcolor>99C9D3E0</textcolor>
				<align>right</align><aligny>center</aligny>
				<label>$INFO[Window.Property(status)]</label>
			</control>
		</control>

		<!-- ═══════════════ LISTE (chaînes, contenu d'un dossier) ═══════════════ -->
		<control type="list" id="400">
			<left>80</left><top>196</top><width>1060</width><height>884</height>
			<orientation>vertical</orientation>
			<onup>200</onup>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<visible>String.IsEqual(Window.Property(layout),list)</visible>
			<itemlayout width="1060" height="118">
				<control type="image">
					<left>16</left><top>9</top><width>176</width><height>99</height>
					<texture border="14" colordiffuse="17FFFFFF">arrmada/rounded-12.png</texture>
				</control>
				<control type="image">
					<left>20</left><top>13</top><width>168</width><height>91</height>
					<aspectratio>keep</aspectratio>
					<fadetime>200</fadetime>
					<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="label">
					<left>216</left><top>14</top><width>820</width><height>44</height>
					<font>font13</font>
					<textcolor>E6F5F7FA</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Property(number),, · ]$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>216</left><top>56</top><width>820</width><height>34</height>
					<font>font11</font>
					<textcolor>B39CCBFF</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
				</control>
				<control type="image">
					<left>216</left><top>96</top><width>360</width><height>8</height>
					<texture>arrmada/progress/$INFO[ListItem.Property(bar)].png</texture>
					<visible>!String.IsEmpty(ListItem.Property(bar))</visible>
				</control>
			</itemlayout>
			<focusedlayout width="1060" height="118">
				<control type="image">
					<left>0</left><top>2</top><width>1060</width><height>114</height>
					<texture border="14" colordiffuse="FF4A9EFF">arrmada/rounded-12.png</texture>
					<visible>Control.HasFocus(400)</visible>
				</control>
				<control type="image">
					<left>0</left><top>2</top><width>1060</width><height>114</height>
					<texture border="14" colordiffuse="404A9EFF">arrmada/rounded-12.png</texture>
					<visible>!Control.HasFocus(400)</visible>
				</control>
				<control type="image">
					<left>16</left><top>9</top><width>176</width><height>99</height>
					<texture border="14" colordiffuse="FF1A2233">arrmada/rounded-12.png</texture>
				</control>
				<control type="image">
					<left>20</left><top>13</top><width>168</width><height>91</height>
					<aspectratio>keep</aspectratio>
					<fadetime>200</fadetime>
					<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="label">
					<left>216</left><top>14</top><width>820</width><height>44</height>
					<font>font13</font>
					<textcolor>FF0A0E16</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Property(number),, · ]$INFO[ListItem.Label]</label>
					<visible>Control.HasFocus(400)</visible>
				</control>
				<control type="label">
					<left>216</left><top>56</top><width>820</width><height>34</height>
					<font>font11</font>
					<textcolor>E60A0E16</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
					<visible>Control.HasFocus(400)</visible>
				</control>
				<control type="label">
					<left>216</left><top>14</top><width>820</width><height>44</height>
					<font>font13</font>
					<textcolor>FFF5F7FA</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Property(number),, · ]$INFO[ListItem.Label]</label>
					<visible>!Control.HasFocus(400)</visible>
				</control>
				<control type="label">
					<left>216</left><top>56</top><width>820</width><height>34</height>
					<font>font11</font>
					<textcolor>FF9CCBFF</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
					<visible>!Control.HasFocus(400)</visible>
				</control>
				<control type="image">
					<left>216</left><top>96</top><width>360</width><height>8</height>
					<texture>arrmada/progress/$INFO[ListItem.Property(bar)].png</texture>
					<visible>!String.IsEmpty(ListItem.Property(bar))</visible>
				</control>
			</focusedlayout>
		</control>

		<!-- Aperçu de l'élément sélectionné dans la liste -->
		<control type="group">
			<left>1196</left><top>212</top>
			<visible>String.IsEqual(Window.Property(layout),list) + Integer.IsGreater(Container(400).NumItems,0)</visible>
			<control type="image">
				<left>0</left><top>0</top><width>640</width><height>360</height>
				<texture border="26" colordiffuse="FF1A2233">arrmada/rounded-24.png</texture>
			</control>
			<control type="image">
				<left>12</left><top>12</top><width>616</width><height>336</height>
				<aspectratio>keep</aspectratio>
				<fadetime>300</fadetime>
				<texture background="true">$INFO[Container(400).ListItem.Art(thumb)]</texture>
			</control>
			<control type="textbox">
				<left>0</left><top>384</top><width>640</width><height>96</height>
				<font>font14_title</font>
				<textcolor>FFF5F7FA</textcolor>
				<label>$INFO[Container(400).ListItem.Label]</label>
			</control>
			<control type="label">
				<left>0</left><top>484</top><width>640</width><height>36</height>
				<font>font12</font>
				<textcolor>FF9CCBFF</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Container(400).ListItem.Label2]</label>
			</control>
			<control type="textbox">
				<left>0</left><top>532</top><width>640</width><height>300</height>
				<font>font12</font>
				<textcolor>D9E6E8EE</textcolor>
				<label>$INFO[Container(400).ListItem.Property(plot)]</label>
			</control>
		</control>
	</controls>
</window>
