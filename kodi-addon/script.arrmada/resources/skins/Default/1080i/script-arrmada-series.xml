<!--
  ArrMada — écran « Série » : saisons → épisodes (ADR-004, phase 4.1).

  Repère 1920 × 1080. Données posées par lib/series_window.py :
    - tout de suite, ce que l'écran appelant connaît (titre, affiche, fanart) ;
    - puis la série lue dans la médiathèque Kodi : saisons (200), épisodes
      (300) avec vu / progression, et l'épisode à suivre déjà sélectionné.
  Navigation : boutons (400) ↓ saisons (200) ↓ épisodes (300) ; Retour ferme.
  Phase 4.4 : les épisodes absents de Kodi (d'après Sonarr) portent la
  propriété `missing` (aired / nas / upcoming / tba) et un badge au centre
  de leur vignette vide (« Manquant », « Sur le NAS », « À venir »).
  Le panneau du bas décrit l'épisode sélectionné (Container(300).ListItem…).
-->
<window>
	<defaultcontrol always="false">401</defaultcontrol>
	<backgroundcolor>FF0A0E16</backgroundcolor>
	<animation effect="fade" start="0" end="100" time="300" tween="sine" easing="out">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>

		<!-- ═══════════════ FOND : fanart (Ken Burns) + voiles ═══════════════ -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0A0E16">arrmada/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>700</fadetime>
			<texture background="true" colordiffuse="73FFFFFF">$INFO[Window.Property(fanart)]</texture>
			<animation effect="zoom" start="100" end="110" time="26000" tween="sine" easing="inout" pulse="true" condition="true" center="960,540">Conditional</animation>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1600</width><height>1080</height>
			<texture colordiffuse="FF0A0E16">arrmada/grad-h.png</texture>
		</control>
		<control type="image">
