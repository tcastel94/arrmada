			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0A0E16">arrmada/white.png</texture>
		</control>
		<!-- Fanart : suit l'affiche sélectionnée, fondu enchaîné de 600 ms. -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>600</fadetime>
			<texture background="true" colordiffuse="73FFFFFF">$INFO[Container(100).ListItem.Art(fanart)]</texture>
		</control>
