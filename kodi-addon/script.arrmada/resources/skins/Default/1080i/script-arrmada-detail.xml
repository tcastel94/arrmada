<?xml version="1.0" encoding="UTF-8"?>
<!--
  ArrMada — écran « Fiche média » (phase 2, ADR-003 § 3).

  Repère 1920 × 1080. Données posées par lib/detail_window.py :
    - tout de suite, ce que l'Accueil connaît déjà (titre, affiche, fanart, logo) ;
    - puis la fiche complète du backend (casting, fichier, notes, sous-titres).
  Navigation : actions (500) ↓ casting (600) ou saisons (610) ; Retour ferme.
-->
<window>
	<defaultcontrol always="false">501</defaultcontrol>
	<backgroundcolor>FF0A0E16</backgroundcolor>
	<animation effect="fade" start="0" end="100" time="300" tween="sine" easing="out">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>

		<!-- ═══════════════ FOND : fanart (Ken Burns) + voiles ═══════════════ -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0A0E16">arrmada/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>700</fadetime>
			<texture background="true" colordiffuse="8CFFFFFF">$INFO[Window.Property(fanart)]</texture>
			<animation effect="zoom" start="100" end="110" time="26000" tween="sine" easing="inout" pulse="true" condition="true" center="960,540">Conditional</animation>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1500</width><height>1080</height>
			<texture colordiffuse="FF0A0E16">arrmada/grad-h.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>420</top><width>1920</width><height>660</height>
			<texture colordiffuse="FF0A0E16">arrmada/grad-v.png</texture>
		</control>
		<control type="image">
			<left>-300</left><top>-380</top><width>1200</width><height>900</height>
			<texture colordiffuse="334A9EFF">arrmada/blob.png</texture>
			<animation effect="fade" start="100" end="50" time="5000" tween="sine" pulse="true" condition="true">Conditional</animation>
		</control>

		<!-- ═══════════════ COLONNE GAUCHE : logo / titre, méta, badges, synopsis ═══════════════ -->
		<control type="group">
			<animation effect="slide" start="-70,0" end="0,0" time="550" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="fade" start="0" end="100" time="450">WindowOpen</animation>
			<control type="image">
				<left>96</left><top>70</top><width>760</width><height>230</height>
				<aspectratio align="left" aligny="bottom">keep</aspectratio>
				<fadetime>400</fadetime>
				<texture background="true">$INFO[Window.Property(clearlogo)]</texture>
				<visible>!String.IsEmpty(Window.Property(clearlogo))</visible>
			</control>
			<control type="textbox">
				<left>96</left><top>150</top><width>1100</width><height>150</height>
				<font>font52_bold</font>
				<textcolor>FFF5F7FA</textcolor>
				<aligny>bottom</aligny>
				<label>$INFO[Window.Property(title)]</label>
				<visible>String.IsEmpty(Window.Property(clearlogo))</visible>
			</control>
			<control type="label">
				<left>96</left><top>318</top><width>1100</width><height>40</height>
				<font>font13</font>
				<textcolor>D9DCE3EE</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Window.Property(meta)]</label>
			</control>
			<control type="label">
				<left>96</left><top>360</top><width>1100</width><height>34</height>
				<font>font12</font>
				<textcolor>FF9CCBFF</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Window.Property(notes)]</label>
			</control>
			<!-- Badges techniques (4K, DV, Atmos, Remux…) -->
			<control type="list" id="520">
				<left>96</left><top>404</top><width>1100</width><height>40</height>
				<orientation>horizontal</orientation>
				<itemlayout width="118" height="40">
					<control type="image">
						<left>0</left><top>0</top><width>106</width><height>38</height>
						<texture border="14" colordiffuse="2E4A9EFF">arrmada/rounded-12.png</texture>
					</control>
					<control type="label">
						<left>0</left><top>0</top><width>106</width><height>38</height>
						<font>font24_bold</font>
						<textcolor>FFDDEEFF</textcolor>
						<align>center</align><aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="118" height="40">
					<control type="image">
						<left>0</left><top>0</top><width>106</width><height>38</height>
						<texture border="14" colordiffuse="2E4A9EFF">arrmada/rounded-12.png</texture>
					</control>
					<control type="label">
						<left>0</left><top>0</top><width>106</width><height>38</height>
						<font>font24_bold</font>
						<textcolor>FFDDEEFF</textcolor>
						<align>center</align><aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
			</control>
			<control type="textbox">
				<left>96</left><top>462</top><width>1080</width><height>212</height>
				<font>font13</font>
				<textcolor>E6E8EEF5</textcolor>
				<autoscroll delay="7000" time="3000" repeat="12000">true</autoscroll>
				<label>$INFO[Window.Property(overview)]</label>
			</control>
			<control type="label">
				<left>96</left><top>680</top><width>1100</width><height>32</height>
				<font>font10</font>
				<textcolor>99C9D3E0</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Window.Property(crew)]</label>
			</control>
		</control>

		<!-- ═══════════════ ACTIONS ═══════════════ -->
		<control type="grouplist" id="500">
			<left>96</left><top>730</top><width>1150</width><height>64</height>
			<orientation>horizontal</orientation>
			<itemgap>16</itemgap>
			<ondown>600</ondown>
			<animation effect="slide" start="0,40" end="0,0" time="500" delay="150" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="fade" start="0" end="100" time="400" delay="150">WindowOpen</animation>
			<control type="button" id="501">
				<width>200</width><height>64</height>
				<label>Lire</label>
				<font>font13</font>
				<textcolor>FF8CC4FF</textcolor>
				<focusedcolor>FF0A0E16</focusedcolor>
				<align>center</align><aligny>center</aligny>
				<texturenofocus border="14" colordiffuse="334A9EFF">arrmada/rounded-12.png</texturenofocus>
				<texturefocus border="14" colordiffuse="FF4A9EFF">arrmada/rounded-12.png</texturefocus>
				<animation effect="zoom" start="100" end="107" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
				<animation effect="zoom" start="107" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
			</control>
			<control type="button" id="502">
				<width>250</width><height>64</height>
				<label>Bande-annonce</label>
				<font>font13</font>
				<textcolor>D9F5F7FA</textcolor>
				<focusedcolor>FF0A0E16</focusedcolor>
				<align>center</align><aligny>center</aligny>
				<texturenofocus border="14" colordiffuse="1AFFFFFF">arrmada/rounded-12.png</texturenofocus>
				<texturefocus border="14" colordiffuse="FF4A9EFF">arrmada/rounded-12.png</texturefocus>
				<!-- Sonarr ne connaît pas de bande-annonce : bouton réservé aux films -->
				<visible>String.IsEqual(Window.Property(kind),movie)</visible>
				<animation effect="zoom" start="100" end="107" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
				<animation effect="zoom" start="107" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
			</control>
			<control type="button" id="503">
				<width>320</width><height>64</height>
				<label>Meilleure version</label>
				<font>font13</font>
				<textcolor>D9F5F7FA</textcolor>
				<focusedcolor>FF0A0E16</focusedcolor>
				<align>center</align><aligny>center</aligny>
				<texturenofocus border="14" colordiffuse="1AFFFFFF">arrmada/rounded-12.png</texturenofocus>
				<texturefocus border="14" colordiffuse="FF4A9EFF">arrmada/rounded-12.png</texturefocus>
				<animation effect="zoom" start="100" end="107" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
				<animation effect="zoom" start="107" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
			</control>
			<control type="button" id="504">
				<width>240</width><height>64</height>
				<label>Sous-titres</label>
				<font>font13</font>
				<textcolor>D9F5F7FA</textcolor>
				<focusedcolor>FF0A0E16</focusedcolor>
				<align>center</align><aligny>center</aligny>
				<texturenofocus border="14" colordiffuse="1AFFFFFF">arrmada/rounded-12.png</texturenofocus>
				<texturefocus border="14" colordiffuse="FF4A9EFF">arrmada/rounded-12.png</texturefocus>
				<visible>String.IsEqual(Window.Property(kind),movie)</visible>
				<animation effect="zoom" start="100" end="107" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
				<animation effect="zoom" start="107" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
			</control>
		</control>

		<!-- ═══════════════ COLONNE DROITE : affiche + fichier ═══════════════ -->
		<control type="group">
			<left>1464</left><top>96</top>
			<animation effect="slide" start="80,0" end="0,0" time="600" delay="80" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="fade" start="0" end="100" time="450" delay="80">WindowOpen</animation>
			<control type="image">
				<left>-36</left><top>-36</top><width>432</width><height>612</height>
				<texture border="56" colordiffuse="664A9EFF">arrmada/glow.png</texture>
			</control>
			<control type="image">
				<left>0</left><top>0</top><width>360</width><height>540</height>
				<texture border="26" colordiffuse="FF1A2233">arrmada/rounded-24.png</texture>
			</control>
			<control type="image">
				<left>0</left><top>0</top><width>360</width><height>540</height>
				<aspectratio>scale</aspectratio>
				<fadetime>300</fadetime>
				<texture background="true" diffuse="arrmada/poster-mask.png">$INFO[Window.Property(poster)]</texture>
			</control>
			<!-- Statut : Disponible / Manquant / 15/19 épisodes -->
			<control type="group">
				<left>14</left><top>490</top>
				<visible>!String.IsEmpty(Window.Property(status))</visible>
				<control type="image">
					<left>0</left><top>0</top><width>210</width><height>36</height>
					<texture border="14" colordiffuse="E60A0E16">arrmada/rounded-12.png</texture>
				</control>
				<control type="image">
					<left>14</left><top>12</top><width>12</width><height>12</height>
					<texture colordiffuse="FF34D399">arrmada/circle.png</texture>
					<visible>!String.IsEqual(Window.Property(status),Manquant)</visible>
				</control>
				<control type="image">
					<left>14</left><top>12</top><width>12</width><height>12</height>
					<texture colordiffuse="FFFBBF24">arrmada/circle.png</texture>
					<visible>String.IsEqual(Window.Property(status),Manquant)</visible>
				</control>
				<control type="label">
					<left>34</left><top>0</top><width>170</width><height>36</height>
					<font>font10</font>
					<textcolor>FFF5F7FA</textcolor>
					<aligny>center</aligny>
					<label>$INFO[Window.Property(status)]</label>
				</control>
			</control>
			<!-- Fichier -->
			<control type="label">
				<left>0</left><top>562</top><width>360</width><height>30</height>
				<font>font12_title</font>
				<textcolor>FF9CCBFF</textcolor>
				<aligny>center</aligny>
				<label>Fichier</label>
			</control>
			<control type="textbox">
				<left>0</left><top>594</top><width>360</width><height>130</height>
				<font>font10</font>
				<textcolor>D9DCE3EE</textcolor>
				<label>$INFO[Window.Property(file)]</label>
			</control>
		</control>
		<control type="label">
			<left>1464</left><top>824</top><width>360</width><height>30</height>
			<font>font10</font>
			<textcolor>99C9D3E0</textcolor>
			<aligny>center</aligny>
			<label>Sous-titres : $INFO[Window.Property(subtitles)]</label>
			<visible>!String.IsEmpty(Window.Property(subtitles))</visible>
		</control>

		<!-- ═══════════════ RANGÉE DU BAS : casting (films) ou saisons (séries) ═══════════════ -->
		<control type="group">
			<animation effect="slide" start="0,80" end="0,0" time="600" delay="250" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="fade" start="0" end="100" time="450" delay="250">WindowOpen</animation>
			<control type="image">
				<left>96</left><top>824</top><width>6</width><height>26</height>
				<texture colordiffuse="FF4A9EFF">arrmada/white.png</texture>
			</control>
			<control type="label">
				<left>116</left><top>818</top><width>700</width><height>38</height>
				<font>font13_title</font>
				<textcolor>FFF5F7FA</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Window.Property(rail_title)]</label>
			</control>
			<control type="label">
				<left>96</left><top>870</top><width>1200</width><height>160</height>
				<font>font12</font>
				<textcolor>80C9D3E0</textcolor>
				<aligny>center</aligny>
				<label>Chargement de la fiche…</label>
				<visible>String.IsEmpty(Window.Property(loaded))</visible>
				<animation effect="fade" start="100" end="35" time="900" tween="sine" pulse="true" condition="true">Conditional</animation>
			</control>

			<!-- Casting : photos rondes -->
			<control type="list" id="600">
				<left>80</left><top>862</top><width>1840</width><height>210</height>
				<orientation>horizontal</orientation>
				<onup>500</onup>
				<scrolltime tween="cubic" easing="out">280</scrolltime>
				<visible>String.IsEqual(Window.Property(kind),movie)</visible>
				<itemlayout width="176" height="210">
					<control type="image">
						<left>34</left><top>14</top><width>108</width><height>108</height>
						<texture colordiffuse="1FFFFFFF">arrmada/circle.png</texture>
					</control>
					<control type="label">
						<left>34</left><top>14</top><width>108</width><height>108</height>
						<font>font16</font>
						<textcolor>99F5F7FA</textcolor>
						<align>center</align><aligny>center</aligny>
						<label>$INFO[ListItem.Property(initials)]</label>
						<visible>String.IsEmpty(ListItem.Art(thumb))</visible>
					</control>
					<control type="image">
						<left>34</left><top>14</top><width>108</width><height>108</height>
						<aspectratio>scale</aspectratio>
						<texture background="true" diffuse="arrmada/circle.png">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="label">
						<left>4</left><top>130</top><width>168</width><height>30</height>
						<font>font10</font>
						<textcolor>FFF5F7FA</textcolor>
						<align>center</align><aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>4</left><top>158</top><width>168</width><height>28</height>
						<font>font10</font>
						<textcolor>80C9D3E0</textcolor>
						<align>center</align><aligny>center</aligny>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</itemlayout>
				<focusedlayout width="176" height="210">
					<control type="group">
						<animation effect="zoom" start="100" end="110" time="220" tween="cubic" easing="out" center="88,68">Focus</animation>
						<control type="image">
							<left>14</left><top>-6</top><width>148</width><height>148</height>
							<texture colordiffuse="994A9EFF">arrmada/blob.png</texture>
							<visible>Control.HasFocus(600)</visible>
						</control>
						<control type="image">
							<left>34</left><top>14</top><width>108</width><height>108</height>
							<texture colordiffuse="1FFFFFFF">arrmada/circle.png</texture>
						</control>
						<control type="label">
							<left>34</left><top>14</top><width>108</width><height>108</height>
							<font>font16</font>
							<textcolor>FFF5F7FA</textcolor>
							<align>center</align><aligny>center</aligny>
							<label>$INFO[ListItem.Property(initials)]</label>
							<visible>String.IsEmpty(ListItem.Art(thumb))</visible>
						</control>
						<control type="image">
							<left>34</left><top>14</top><width>108</width><height>108</height>
							<aspectratio>scale</aspectratio>
							<texture background="true" diffuse="arrmada/circle.png">$INFO[ListItem.Art(thumb)]</texture>
						</control>
					</control>
					<control type="label">
						<left>4</left><top>130</top><width>168</width><height>30</height>
						<font>font10</font>
						<textcolor>FFF5F7FA</textcolor>
						<align>center</align><aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>4</left><top>158</top><width>168</width><height>28</height>
						<font>font10</font>
						<textcolor>FF9CCBFF</textcolor>
						<align>center</align><aligny>center</aligny>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</focusedlayout>
			</control>

			<!-- Saisons : cartes avec progression -->
			<control type="list" id="610">
				<left>80</left><top>870</top><width>1840</width><height>170</height>
				<orientation>horizontal</orientation>
				<onup>500</onup>
				<scrolltime tween="cubic" easing="out">280</scrolltime>
				<visible>String.IsEqual(Window.Property(kind),tvshow)</visible>
				<itemlayout width="336" height="170">
					<control type="image">
						<left>16</left><top>10</top><width>304</width><height>140</height>
						<texture border="26" colordiffuse="14FFFFFF">arrmada/rounded-24.png</texture>
					</control>
					<control type="label">
						<left>40</left><top>28</top><width>260</width><height>40</height>
						<font>font14_title</font>
						<textcolor>FFF5F7FA</textcolor>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>40</left><top>72</top><width>260</width><height>30</height>
						<font>font10</font>
						<textcolor>99C9D3E0</textcolor>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label2]</label>
					</control>
					<control type="image">
						<left>40</left><top>116</top><width>256</width><height>10</height>
						<texture>arrmada/progress/$INFO[ListItem.Property(bar)].png</texture>
					</control>
				</itemlayout>
				<focusedlayout width="336" height="170">
					<control type="group">
						<animation effect="zoom" start="100" end="106" time="200" tween="cubic" easing="out" center="168,80">Focus</animation>
						<control type="image">
							<left>-14</left><top>-20</top><width>364</width><height>200</height>
							<texture border="56" colordiffuse="804A9EFF">arrmada/glow.png</texture>
							<visible>Control.HasFocus(610)</visible>
						</control>
						<control type="image">
							<left>16</left><top>10</top><width>304</width><height>140</height>
							<texture border="26" colordiffuse="14FFFFFF">arrmada/rounded-24.png</texture>
							<visible>!Control.HasFocus(610)</visible>
						</control>
						<control type="image">
							<left>16</left><top>10</top><width>304</width><height>140</height>
							<texture border="26" colordiffuse="FF16203A">arrmada/rounded-24.png</texture>
							<visible>Control.HasFocus(610)</visible>
						</control>
						<control type="image">
							<left>16</left><top>10</top><width>304</width><height>140</height>
							<texture border="26" colordiffuse="FF4A9EFF">arrmada/ring-24.png</texture>
							<visible>Control.HasFocus(610)</visible>
						</control>
						<control type="label">
							<left>40</left><top>28</top><width>260</width><height>40</height>
							<font>font14_title</font>
							<textcolor>FFF5F7FA</textcolor>
							<aligny>center</aligny>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<left>40</left><top>72</top><width>260</width><height>30</height>
							<font>font10</font>
							<textcolor>FF9CCBFF</textcolor>
							<aligny>center</aligny>
							<label>$INFO[ListItem.Label2]</label>
						</control>
						<control type="image">
							<left>40</left><top>116</top><width>256</width><height>10</height>
							<texture>arrmada/progress/$INFO[ListItem.Property(bar)].png</texture>
						</control>
					</control>
				</focusedlayout>
			</control>
		</control>

		<!-- Indicateur de chargement + aide -->
		<control type="image">
			<left>1784</left><top>36</top><width>40</width><height>40</height>
			<texture colordiffuse="FF4A9EFF">arrmada/spinner.png</texture>
			<visible>String.IsEmpty(Window.Property(loaded))</visible>
			<animation effect="rotate" end="-360" center="auto" time="900" loop="true" condition="true">Conditional</animation>
		</control>
		<control type="label">
			<left>1224</left><top>1040</top><width>600</width><height>30</height>
			<font>font10</font>
			<textcolor>66C9D3E0</textcolor>
			<align>right</align><aligny>center</aligny>
			<label>Lecture : lire   ·   Retour : accueil</label>
		</control>
	</controls>
</window>
