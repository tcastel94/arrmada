<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <category label="30100">
        <setting id="server_url" type="text" label="30102" default="http://192.168.2.3:8420" />
        <!-- Ancien mot de passe admin : plus saisi sur la TV depuis la 1.8 (phase 3).
             Gardé caché pour que lib/migration.py le lise une fois, puis l'efface. -->
        <setting id="api_key" type="text" label="30104" default="" option="hidden" visible="false" />
        <setting id="device_name" type="text" label="30106" default="Kodi Salon" />
    </category>
    <category label="30120">
        <setting id="sub_language" type="labelenum" label="30122" values="fr|en|es|de|it" default="fr" />
        <setting id="enable_scrobble" type="bool" label="30124" default="true" />
        <setting id="enable_notifications" type="bool" label="30126" default="true" />
        <setting id="notify_during_playback" type="bool" label="30132" default="false" />
        <setting id="check_interval" type="number" label="30128" default="30" />
        <setting id="auto_audio_switch" type="bool" label="30130" default="true" />
        <setting id="room_profile" type="labelenum" label="30131" values="cinema|salon" default="cinema" />
    </category>
    <!-- Coché automatiquement si Kodi se ferme 2 fois de suite au démarrage
         (lib/startup_guard.py) ; à décocher pour revenir au fonctionnement normal. -->
    <category label="30140">
        <setting id="safe_mode" type="bool" label="30141" default="false" />
    </category>
</settings>
